{
  "name": "appdock",
  "version": "0.14.0",
  "description": "Create desktop apps and installable web exports from local projects",
  "author": "GoldRock AI",
  "license": "MIT",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/unit-tests.cjs",
    "preview:site": "node scripts/preview-site.cjs",
    "build:site": "node scripts/build-site.cjs",
    "test:design": "node scripts/run-design-check.cjs",
    "test:aero": "node scripts/run-design-check.cjs --aero",
    "smoke": "electron . --smoke-test",
    "test:projects": "electron . --project-smoke",
    "inspect": "node src/cli.cjs inspect",
    "build": "electron-builder --config electron-builder.config.cjs",
    "build:plugin": "node scripts/assemble-plugin.cjs",
    "test:plugin": "node --test integrations/codex/test/*.cjs",
    "test:languages": "node scripts/test-languages.cjs",
    "release:check": "node scripts/release-check.cjs",
    "test:services": "node scripts/test-compiled-services.cjs",
    "build:production": "electron-builder --win portable --x64 --config electron-builder.production.cjs --publish never",
    "build:supervisor": "node scripts/build-process-broker.cjs",
    "test:package-managers": "node scripts/test-package-managers.cjs",
    "build:launcher": "node scripts/build-launcher.cjs",
    "public:check": "node scripts/check-public-source.cjs",
    "package:release": "node scripts/package-public-release.cjs",
    "build:windows": "electron-builder --win portable --x64 --config electron-builder.config.cjs",
    "build:mac": "electron-builder --mac zip --config electron-builder.config.cjs",
    "build:linux": "electron-builder --linux AppImage --config electron-builder.config.cjs",
    "postinstall": "node scripts/prepare-terminal.cjs",
    "test:views": "node scripts/run-design-check.cjs --views",
    "test:originals": "node scripts/run-design-check.cjs --originals",
    "test:motion": "node scripts/run-design-check.cjs --motion"
  },
  "devDependencies": {
    "axe-core": "^4.14.1",
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "ai.goldrock.makeapp",
    "productName": "Make App",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      {
        "from": "examples",
        "to": "examples",
        "filter": [
          "**/*"
        ]
      },
      "!**/*.pdb"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "src/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "unpackDirName": true,
      "artifactName": "Make-App-${version}-Windows.exe"
    },
    "compression": "normal",
    "nsis": {
      "artifactName": "Make-App-${version}-Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "extraResources": [
      {
        "from": "native/bin/appdock-process-win-x64.exe",
        "to": "bin/appdock-process.exe"
      },
      {
        "from": "native/bin/RUST-STANDARD-LIBRARY-NOTICES.html",
        "to": "bin/RUST-STANDARD-LIBRARY-NOTICES.html"
      },
      {
        "from": "native/bin/licenses",
        "to": "bin/licenses",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "native/bin/appdock-launcher-win-x64.exe",
        "to": "bin/appdock-launcher.exe"
      }
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ]
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "smol-toml": "1.9.1"
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch": "11.0.1"
    },
    "@electron/universal": {
      "minimatch": "11.0.1"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/moonshineaitech/make-app.git"
  },
  "homepage": "https://github.com/moonshineaitech/make-app",
  "bugs": {
    "url": "https://github.com/moonshineaitech/make-app/issues"
  }
}
