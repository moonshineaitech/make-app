{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "appdock": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/server/index.cjs"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "none"
          }
        }
      }
    }
  }
}
